{
  "manifest_version": 3,
  "name": "Pawse — Watch Together",
  "version": "0.1.0",
  "description": "Watch YouTube together in perfect sync with your partner. Play, pause, and seek as one. Purr-fectly synced. 🐾",

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Pawse — Watch Together",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["config.js", "sync-core.js", "content/content.js"],
      "run_at": "document_idle"
    }
  ],

  "permissions": ["storage", "tabs"],

  "host_permissions": [
    "wss://pawse-relay.onrender.com/*",
    "https://pawse-relay.onrender.com/*",
    "ws://localhost:8080/*",
    "http://localhost:8080/*"
  ],

  "incognito": "split"
}
